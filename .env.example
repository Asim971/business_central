# Business Central scripts — configuration template (QA environment)
# Copy to .env.qa and fill in the secret values. .env.qa is gitignored.
# Key names mirror the logistics-distribution backend (ASP.NET Core "__" section separator)
# so the same values can be shared between Railway, GitHub Actions and local runs.

ASPNETCORE_ENVIRONMENT=qa

# --- Microsoft Entra ID (S2S client-credentials app used to call Business Central) ---
AzureAd__Instance=https://login.microsoftonline.com/
AzureAd__TenantId=872c1968-2e78-4f6c-a637-c5cc82c9a5d0
AzureAd__ClientId=1b7aaeb5-6ae2-48e1-b5dc-c376fa4a2d1f
AzureAd__ClientSecret=<secret>

# --- Business Central Online target ---
Bc__TenantId=872c1968-2e78-4f6c-a637-c5cc82c9a5d0
Bc__Environment=QA-AGI
Bc__CompanyId=7325599f-36d4-f011-8542-000d3a083395
Bc__AlPingEnabled=true

# --- Logistics backend (only needed when the scripts talk to the backend/Postgres) ---
Auth__JwtSigningKey=<secret>
ConnectionStrings__Logistics=Host=<host>;Port=5432;Database=<db>;Username=<user>;Password=<secret>;Ssl Mode=Require;Trust Server Certificate=true
Cors__AllowedOrigins=https://web-qa-c7e6.up.railway.app
MigrateOnStartup=true
Seed__SuperAdminUsername=<username>
Seed__SuperAdminPassword=<secret>

# --- SMTP (Brevo relay) ---
Smtp__Host=smtp-relay.brevo.com
Smtp__Port=587
Smtp__Username=<username>
Smtp__Password=<secret>
Smtp__From=<email>
